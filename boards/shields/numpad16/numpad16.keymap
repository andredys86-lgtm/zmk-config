#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define CALC_DOT 10
#define CALC_ADD 11
#define CALC_SUB 12
#define CALC_MUL 13
#define CALC_DIV 14
#define CALC_EQ 15
#define CALC_CLR 16
#define CALC_CW 17
#define CALC_CCW 18
#define CALC_MENU 19

/ {
    behaviors {
        calc: calc {
            compatible = "zmk,behavior-calc";
            #binding-cells = <1>;
            display-name = "Calc";
        };

        dyn: dyn {
            compatible = "zmk,behavior-dyn";
            #binding-cells = <1>;
            display-name = "Dyn";
        };

        menu: menu {
            compatible = "zmk,behavior-menu";
            #binding-cells = <1>;
            display-name = "Menu";
        };

        ht_menu: ht_menu {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <600>;
            bindings = <&to>, <&dyn>;
        };

        ht_exit: ht_exit {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <600>;
            bindings = <&menu>, <&menu>;
        };

        ht_calc: ht_calc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <600>;
            bindings = <&calc>, <&calc>;
        };

        ht_l0: ht_l0 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <600>;
            bindings = <&to>, <&kp>;
        };

        ht_bt: ht_bt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <600>;
            bindings = <&to>, <&none>;
        };

        enc_none: enc_none {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&none>, <&none>;
        };

        ht_pg: ht_pg {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <600>;
            bindings = <&to>, <&to>;
        };

        enc_pg: enc_pg {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&none>, <&to 1>;
        };

        enc_l0: enc_l0 {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&to 1>, <&to 0>;
        };

        enc_l1: enc_l1 {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&calc CALC_CW>, <&calc CALC_CCW>;
        };

        enc_l2: enc_l2 {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&to 2>, <&to 1>;
        };

        enc_menu: enc_menu {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&menu 17>, <&menu 18>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp KP_N7  &kp KP_N8        &kp KP_N9   &kp KP_DIVIDE
                &kp KP_N4  &kp KP_N5        &kp KP_N6   &kp KP_MINUS
                &kp KP_N1  &kp KP_N2        &kp KP_N3   &kp KP_PLUS
                &kp KP_MULTIPLY  &kp KP_N0  &kp KP_DOT  &kp KP_ENTER
                &ht_l0 4 KP_NUMLOCK
            >;

            sensor-bindings = <&enc_l0>;
        };

        calc_layer {
            bindings = <
                &calc 7  &calc 8         &calc 9         &calc CALC_DIV
                &calc 4  &calc 5         &calc 6         &calc CALC_SUB
                &calc 1  &calc 2         &calc 3         &calc CALC_ADD
                &calc CALC_MUL  &calc 0  &calc CALC_DOT  &calc CALC_EQ
                &ht_calc CALC_CLR CALC_MENU
            >;

            sensor-bindings = <&enc_l1>;
        };

        prog_layer {
            bindings = <
                &dyn 0   &dyn 1   &dyn 2   &dyn 3
                &dyn 4   &dyn 5   &dyn 6   &dyn 7
                &dyn 8   &dyn 9   &dyn 10  &dyn 11
                &dyn 12  &dyn 13  &dyn 14  &dyn 15
                &ht_pg 3 5
            >;

            sensor-bindings = <&enc_l2>;
        };

        menu_layer {
            bindings = <
                &menu 0   &menu 1   &menu 2   &menu 3
                &menu 4   &menu 5   &menu 6   &menu 7
                &menu 8   &menu 9   &menu 10  &menu 11
                &menu 12  &menu 13  &menu 14  &menu 15
                &ht_exit 19 16
            >;

            sensor-bindings = <&enc_menu>;
        };

        bt_layer {
            bindings = <
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3
                &bt BT_SEL 4  &none         &none         &none
                &none         &none         &none         &none
                &bt BT_CLR    &none         &none         &none
                &ht_bt 0 0
            >;

            sensor-bindings = <&enc_none>;
        };

        prog_layer2 {
            bindings = <
                &dyn 17  &dyn 18  &dyn 19  &dyn 20
                &dyn 21  &dyn 22  &dyn 23  &dyn 24
                &dyn 25  &dyn 26  &dyn 27  &dyn 28
                &dyn 29  &dyn 30  &dyn 31  &dyn 32
                &ht_pg 3 6
            >;

            sensor-bindings = <&enc_pg>;
        };

        prog_layer3 {
            bindings = <
                &dyn 34  &dyn 35  &dyn 36  &dyn 37
                &dyn 38  &dyn 39  &dyn 40  &dyn 41
                &dyn 42  &dyn 43  &dyn 44  &dyn 45
                &dyn 46  &dyn 47  &dyn 48  &dyn 49
                &ht_pg 3 2
            >;

            sensor-bindings = <&enc_pg>;
        };
    };
};
